@startuml SAYCEP_A3_Class
' Assignment 3 Q3.3 - class diagram updated to the implemented system.
' Changes from Assignment 2: the profile type is a discriminator column,
' not two subclasses; PathwayStep carries SkillFocus items badged new or
' deeper; Pathway has exactly four steps (three intermediate plus target).
title SAYCEP - Class Diagram (as implemented)
skinparam classAttributeIconSize 0
skinparam shadowing false

package "Persisted - tables in saycep.db" {
  class Profile <<users>> {
    + profileId : str
    + profileType : str  (student | school_leaver)
    + targetSocCode : str [0..1]
    + createdAt : datetime
  }
  class Occupation <<occupations>> {
    + socCode : str
    + title : str
    + description : str
    + jobZone : int
    + sourceDataset : str
  }
  class Skill <<skills>> {
    + elementId : str
    + name : str
    + description : str
    + sourceDataset : str
  }
  class OccupationSkill <<occupation_skills>> {
    + importance : float
    + importanceScaleMax : float
    + sourceDate : str
    + isEssential(threshold : float) : bool
  }
  class RelatedOccupation <<related_occupations>> {
    + tier : str
    + sortIndex : int
  }
  class JobZone <<job_zone_reference>> {
    + zone : int
    + name : str
    + education : str
    + experience : str
    + training : str
  }
}

package "Computed per request - not persisted" {
  class SkillsGap {
    + threshold : float
    + alreadyHeldCount : int
    + missingEssentialCount : int
    + missingDesirableCount : int
    + message : str [0..1]
  }
  class Pathway {
    + intermediateSteps : int
    + orderingBasis : str
  }
  class PathwayStep {
    + step : int
    + isTarget : bool
    + expertReviewIndex : int [0..1]
  }
  class SkillFocus {
    + importance : float
    + essential : bool
    + badge : str  (new | deeper | none)
    + fromImportance : float [0..1]
    + toImportance : float [0..1]
  }
  class Recommendation {
    + score : float
  }
}

package "Services - backend modules" {
  class GapAnalyser <<gap.py>> {
    + computeGap(profileId, socCode) : SkillsGap
  }
  class PathwayService <<pathway.py>> {
    + generatePathway(profileId, socCode) : Pathway
    - stepFocus(socCode, held, previousSoc) : SkillFocus[*]
    - rankByCloseness(held, candidates) : RelatedOccupation[*]
  }
  class RecommendationEngine <<recommend.py>> {
    + recommend(held, limit, maxJobZone) : Recommendation[*]
    + cosine(a, b) : float
    - centreProfile(held, means) : float[35]
    - centreOccupations(vectors, means) : map
  }
  class OccupationRepository <<repository.py>> {
    + createProfile(type, skills, target) : str
    + setTarget(profileId, socCode)
    + requiredSkills(socCode) : OccupationSkill[*]
    + relatedOccupations(socCode) : RelatedOccupation[*]
  }
}

Profile "0..*" -- "0..35" Skill : holds >
Profile "0..*" --> "0..1" Occupation : targets >
Occupation "0..*" --> "1" JobZone : graded by >
Occupation "1" *-- "1..35" OccupationSkill
OccupationSkill "0..*" --> "1" Skill
Occupation "1" *-- "0..20" RelatedOccupation
RelatedOccupation "0..*" --> "1" Occupation : points to >

SkillsGap "0..*" --> "1" Occupation : against >
Pathway "1" *-- "4" PathwayStep
PathwayStep "1" *-- "1..6" SkillFocus
PathwayStep "0..*" --> "1" Occupation : reaches >
Recommendation "0..*" --> "1" Occupation

GapAnalyser ..> OccupationRepository
PathwayService ..> OccupationRepository
PathwayService ..> RecommendationEngine
GapAnalyser ..> SkillsGap : creates
PathwayService ..> Pathway : creates
RecommendationEngine ..> Recommendation : creates

note right of Pathway
  Four steps: three intermediate (FR-08 minimum,
  verified reachable for all 879 occupations)
  plus the target occupation itself.
end note
note right of RecommendationEngine
  <<emerging technology>>
end note
@enduml

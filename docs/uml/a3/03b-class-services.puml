@startuml SAYCEP_A3_Class_Services
' Assignment 3 Q3.3, part B - the service classes (backend modules) and
' their operations, as implemented. Domain classes are detailed in part A.
' Version 1.1 (30 September): profile read and progress endpoints, step
' readiness, task statements, and the PlainLabels module.
title SAYCEP - Class Diagram, part B: services (as implemented)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 50

class SaycepApi <<app.py>> {
  + listOccupations(zone, q, limit)
  + getOccupation(socCode, profileId [0..1])
  + listSkills()
  + createProfile(body) : Profile
  + getProfile(profileId) : Readiness
  + setSkillStatus(profileId, elementId, status)
  + removeSkill(profileId, elementId)
  + setTarget(profileId, socCode)
  + getGap(profileId, socCode) : SkillsGap
  + getPathway(profileId, socCode) : Pathway
  + getRecommendations(profileId, limit, maxJobZone)
}
class GapAnalyser <<gap.py>> {
  + computeGap(profileId, socCode) : SkillsGap
}
class PathwayService <<pathway.py>> {
  + generatePathway(profileId, socCode) : Pathway
  + stepReadiness(socCode, held) : bool
  - stepFocus(socCode, held, previousSoc) : SkillFocus[1..6]
  - rankByCloseness(held, candidates) : RelatedOccupation[*]
}
class RecommendationEngine <<recommend.py>> #D6E8F5 {
  + recommend(held, limit, maxJobZone) : Recommendation[*]
  + cosine(a : float[35], b : float[35]) : float
  + loadVectors() : map
  + centreProfile(held, means) : float[35]
  + centreOccupations(vectors, means) : map
}
class OccupationRepository <<repository.py>> {
  + createProfile(type, skills, target) : str
  + getProfile(profileId) : Profile
  + setTarget(profileId, socCode)
  + profileSkillIds(profileId) : str[*]  (held only)
  + profileSkills(profileId) : UserSkill[*]
  + setSkillStatus(profileId, elementId, status)
  + removeSkill(profileId, elementId)
  + occupationTasks(socCode, limit) : OccupationTask[*]
  + getOccupation(socCode) : Occupation
  + listOccupations(zone, query, limit) : Occupation[*]
  + requiredSkills(socCode) : OccupationSkill[*]
  + relatedOccupations(socCode) : RelatedOccupation[*]
  + ensureProfileTables()
}
class PlainLabels <<plain.py>> {
  + importanceLevel(importance) : str
  + matchLevel(score) : str
  + preparation(zone) : str
  + skillGroup(elementId) : str
}
class Config <<config.py>> {
  + ESSENTIAL_THRESHOLD : float = 3.5
  + PATHWAY_INTERMEDIATE_STEPS : int = 3
}

SaycepApi ..> GapAnalyser
SaycepApi ..> PathwayService
SaycepApi ..> RecommendationEngine
SaycepApi ..> OccupationRepository
SaycepApi ..> PlainLabels : labels every figure
PlainLabels ..> Config
PathwayService ..> RecommendationEngine : ranks steps
PathwayService ..> OccupationRepository
GapAnalyser ..> OccupationRepository
GapAnalyser ..> Config
PathwayService ..> Config
RecommendationEngine ..> Config

note right of RecommendationEngine
  <<emerging technology>>
  Mean-centred cosine similarity
  over 35-dimensional vectors
end note
@enduml

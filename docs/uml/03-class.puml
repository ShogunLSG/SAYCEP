@startuml SAYCEP_Class
' SAYCEP - Class Diagram (Assignment 2, Q4.3)
skinparam classAttributeIconSize 0

abstract class Profile {
  - profileId : UUID
  - createdAt : DateTime
  + captureSkills(skills : Skill[]) : void
  + setTarget(occupation : Occupation) : void
  + hasSkill(skill : Skill) : boolean
}

class StudentProfile {
  - institution : String
  + searchCatalogue(query : String) : Occupation[]
}

class SchoolLeaverProfile {
  - maxJobZone : int
  + browseByPreparationLevel(zone : int) : Occupation[]
}

class Skill {
  - elementId : String
  - name : String
  - description : String
  - sourceDataset : String
}

class Occupation {
  - socCode : String
  - title : String
  - description : String
  - sourceDataset : String
  + requiredSkills() : OccupationSkill[]
  + skillVector() : double[]
}

class OccupationSkill {
  - importance : double
  - importanceScaleMax : double
  - sourceDate : String
  + isEssential(threshold : double) : boolean
}

class JobZone {
  - zone : int
  - name : String
  - education : String
  - experience : String
  - training : String
}

class SkillsGap {
  - generatedAt : DateTime
  + missingSkills() : OccupationSkill[]
  + essential() : OccupationSkill[]
  + desirable() : OccupationSkill[]
}

class Pathway {
  - generatedAt : DateTime
  + stepCount() : int
}

class PathwayStep {
  - sortIndex : int
  - relatednessTier : String
  + skillsToAcquire() : Skill[]
}

class RecommendationEngine <<emerging technology>> {
  - threshold : double
  + rank(profile : Profile, candidates : Occupation[]) : Occupation[]
  + cosineSimilarity(a : double[], b : double[]) : double
}

StudentProfile --|> Profile
SchoolLeaverProfile --|> Profile

Profile "1" o-- "0..*" Skill : has captured >
Profile "0..*" --> "0..1" Occupation : targets >
Occupation "0..*" --> "1" JobZone : requires preparation >
Occupation "1" *-- "1..*" OccupationSkill : requires >
OccupationSkill "0..*" --> "1" Skill : refers to >
Occupation "1" --> "0..*" Occupation : related to >

Profile "1" --> "0..*" SkillsGap : generates >
SkillsGap "0..*" --> "1" Occupation : against target >
SkillsGap "1" --> "1" Pathway : ordered into >
Pathway "1" *-- "3..*" PathwayStep : composed of >
PathwayStep "0..*" --> "1" Occupation : reaches >

RecommendationEngine ..> Profile : reads
RecommendationEngine ..> Occupation : ranks

note bottom of Pathway
  Multiplicity 3..* on PathwayStep
  enforces FR-08: no fewer than
  three intermediate steps.
end note
@enduml
